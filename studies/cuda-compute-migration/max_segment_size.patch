@@ -51,6 +51,22 @@ def make_segment_views(offsets):
     return offsets[:-1], offsets[1:]
 
 
+def _max_segment_size(start_o, end_o):
+    """
+    Largest segment length, as a Python int.
+
+    Passed as the ``max_segment_size`` hint to ``cuda.compute.segmented_reduce``
+    so CCCL can pick a thread/warp-cooperative kernel for jagged data with
+    short segments instead of always falling back to the block-cooperative
+    variant. Cost is one device reduction over ``num_segments`` (much smaller
+    than the segmented reduce itself, which is ``num_elements``) plus a host
+    sync to fetch the scalar.
+    """
+    if start_o.size == 0:
+        return 0
+    return int((end_o - start_o).max())
+
